# ============================================================
# Whitelist .gitignore — ignore everything, allow only essentials
# ============================================================

# Ignore everything by default
*

# ---------- Top-level files ----------
!.gitignore
!.gitattributes

# ---------- Docs ----------
!SIM/docs/
!SIM/docs/**

# ---------- Documentation ----------
!Documentation/
!Documentation/*.tex
!Documentation/*.bib
!Documentation/figures/
!Documentation/figures/**
!Documentation/vertopal_7bfba83002a042659755220b13a52129/
!Documentation/vertopal_7bfba83002a042659755220b13a52129/media/
!Documentation/vertopal_7bfba83002a042659755220b13a52129/media/**

# ---------- Unified logs (TensorBoard) ----------
!logs/
!logs/tensorboard/
!logs/tensorboard/.gitkeep

# ---------- Trained model checkpoints ----------
!models/
!models/.gitkeep

# ---------- Unity project (SIM) ----------
!SIM/

# Allow Assets (scripts, scenes, settings, input config)
!SIM/Assets/
!SIM/Assets/scripts/
!SIM/Assets/scripts/**
!SIM/Assets/scripts.meta
!SIM/Assets/Scenes/
!SIM/Assets/Scenes/**
!SIM/Assets/Scenes.meta
!SIM/Assets/Settings/
!SIM/Assets/Settings/**
!SIM/Assets/Settings.meta
!SIM/Assets/InputSystem_Actions.inputactions
!SIM/Assets/InputSystem_Actions.inputactions.meta


# Allow Packages (dependency manifest)
!SIM/Packages/
!SIM/Packages/manifest.json
!SIM/Packages/packages-lock.json

# Allow ProjectSettings
!SIM/ProjectSettings/
!SIM/ProjectSettings/**

# ---------- GitHub Copilot agents & workflows ----------
!.github/
!.github/agents/
!.github/agents/**
!.github/workflows/
!.github/workflows/**

# ---------- Eclipse Leda ----------
!leda/
!leda/*.md
!leda/*.txt
!leda/*.sh
!leda/*.cmd
!leda/LICENSE
!leda/examples/
!leda/examples/**

# MQTT→KUKSA Feeder
!leda/mqtt-kuksa-feeder/
!leda/mqtt-kuksa-feeder/**

# Velocitas Vehicle App
!leda/velocitas-app/
!leda/velocitas-app/**

# Leda Controller (MQTT bridge, debug drive, RL training)
!leda/leda-controller/
!leda/leda-controller/Dockerfile
!leda/leda-controller/*.py
!leda/leda-controller/*.txt
!leda/leda-controller/*.json

# ---------- Unity training launch scripts ----------
!SIM/*.cmd
!SIM/*.sh


# ---------- Resources (for car visuals) ----------
!SIM/Assets/Resources/
SIM/Assets/Resources/*.meta